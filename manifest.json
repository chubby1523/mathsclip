{
  "manifest_version": 3,
  "name": "MathsClip — Copy Math & Equations as LaTeX",
  "version": "1.0.0",
  "minimum_chrome_version": "123",
  "description": "Copy maths from any web page as clean LaTeX or Markdown, using Ctrl+C, the right-click menu, or click-to-copy.",
  "permissions": [
    "contextMenus",
    "storage",
    "clipboardWrite"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "MathsClip Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/main-world.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/defaults.js",
        "src/extractors.js",
        "src/serializer.js",
        "src/content.js"
      ],
      "world": "ISOLATED",
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
